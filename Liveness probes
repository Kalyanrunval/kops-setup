apiVersion: v1
kind: Pod
metadata:
  name: liveness
spec:
  containers:
  - name: cont1
    image: nginx
    ports:
    - containerPort: 80
    args:
    - /bin/sh
    - -c
    - touch /tmp/flm; sleep 1000     ----------> to run the contionuer contionuesly so backloop error will not come
    livenessProbe:
      exec:
        command:      |
        - cat         |    -----------> to excute the command 
        - /tmp/flm    |
      initialDelaySeconds: 5 (    --------> After 5sec of createing the pod the command will be exicute  
      periodSeconds: 5    ( ---------> It will check every 5 sec
      timeoutSeconds: 30  (--------> until 30 sec it will check still it will not responding so it will delete the container and again recreate the container
