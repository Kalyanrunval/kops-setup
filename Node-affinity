apiVersion: v1
kind: Pod
metadata:
  name: pod-1
spec:
  containers:
  - name: cont1
    image: nginx
    ports:
    - containerPort: 80

  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
        - matchExpressions:
          - key: app   --------> app is the key 
            operator: In
            values:
            - swiggy    ---------> node label name there we mantation 
